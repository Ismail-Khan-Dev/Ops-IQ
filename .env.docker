# ── Docker Compose Environment ──────────────────────────────
# Copy this to .env.docker and fill in production values.
# Used by docker-compose.yml and deploy.sh preflight checks.

# ── App ────────────────────────────────────────────────────
ENV=production
DEBUG=false
PROJECT_NAME=opsiq
LOG_LEVEL=WARNING

# ── Authentication (generate: openssl rand -hex 32) ───────
API_KEY=

# ── Server ─────────────────────────────────────────────────
UVICORN_WORKERS=4
HTTP_PORT=8000

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=["https://yourdomain.com"]

# ── LLM Keys ──────────────────────────────────────────────
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=gemini-2.0-flash

# ── Shopify ────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_PASSWORD=
SHOPIFY_STORE_URL=
SHOPIFY_API_VERSION=2024-01
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# ── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ecommerce_ops
REDIS_URL=redis://redis:6379/0

# ── Connection Pool ────────────────────────────────────────
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Safety Thresholds ──────────────────────────────────────
GLOBAL_PO_LIMIT=1000.0
GLOBAL_PRICE_CHANGE_LIMIT_PERCENT=20.0
SHADOW_MODE=true
AUTO_APPROVE_THRESHOLD_DECISIONS=50
AUTO_APPROVE_CONFIDENCE_SCORE=0.95
RATE_LIMIT_PER_MINUTE=60

# ── Notifications ──────────────────────────────────────────
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# ── SSO (optional) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=

# ── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
PROMETHEUS_SCRAPE_TOKEN=CHANGE_ME

# ── Backups ────────────────────────────────────────────────
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POSTGRES_CONTAINER=opsiq-postgres
