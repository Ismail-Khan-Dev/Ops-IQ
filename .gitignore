# pyenv
#   For a library or app, you might want to share your .python-version.
#   See https://github.com/pyenv/pyenv/blob/master/555_user_editing_pyenv.md#shared-local-python-versions
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if lock is not desired, it can be added here.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
# .pdm-python.path
# .pdm-build/

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
# Real environment / secret files must NEVER be committed.
# (Secrets were previously leaked via .env.production / .env.docker and
#  scrubbed from history; keep them local-only from now on.)
.env
.env.*
!.env.example
!.env.docker
!**/.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

